{
  "name": "@mars.liu/dsh-web-launcher",
  "version": "1.0.8",
  "type": "module",
  "description": "Manage the standalone CLI dsh web server from DSH Desktop: start, stop, restart, status and logs, with an isolated environment.",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "web",
    "launcher",
    "desktop"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/MarchLiu/dsh-web-launcher.git"
  },
  "homepage": "https://github.com/MarchLiu/dsh-web-launcher#readme",
  "bugs": {
    "url": "https://github.com/MarchLiu/dsh-web-launcher/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/en.json",
    "locale/zh.json",
    "icon.svg",
    "README.md",
    "scripts/verify.mjs"
  ],
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-layout",
        "@deepseek-ai/dsh-client-ui-sidebar"
      ]
    }
  }
}
